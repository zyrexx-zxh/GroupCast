# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/groupcast

# ─── Email (Gmail App Password) ────────────────────────────────────────────────
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx   # 16-char Gmail App Password (no spaces needed)

# ─── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string
NODE_ENV=development
